{
    "_说明": "ComfyUI 工作流模板示例。在 ComfyUI 中把工作流导出为 API 格式（Save -> API Format），把提示词/种子/尺寸/参考图等值替换为占位符。可用占位符：{{PROMPT}} {{NEGATIVE}} {{SEED}} {{WIDTH}} {{HEIGHT}} {{REFERENCE_IMAGE}}（第1张参考图，程序会先通过 /upload/image 上传并回填文件名）{{REFERENCE_IMAGE_1..N}}。带 IP-Adapter 的受控参考图工作流示例见节点 10-13，不需要时删除这些节点及节点 6 中对 13 的引用即可。",
    "3": {
        "class_type": "KSampler",
        "inputs": {
            "seed": "{{SEED}}",
            "steps": 25,
            "cfg": 7.0,
            "sampler_name": "euler",
            "scheduler": "normal",
            "denoise": 1.0,
            "model": ["10", 0],
            "positive": ["13", 0],
            "negative": ["7", 0],
            "latent_image": ["5", 0]
        }
    },
    "4": {
        "class_type": "CheckpointLoaderSimple",
        "inputs": { "ckpt_name": "pixel_art_model.safetensors" }
    },
    "5": {
        "class_type": "EmptyLatentImage",
        "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 }
    },
    "6": {
        "class_type": "CLIPTextEncode",
        "inputs": { "text": "{{PROMPT}}", "clip": ["11", 1] }
    },
    "7": {
        "class_type": "CLIPTextEncode",
        "inputs": { "text": "{{NEGATIVE}}", "clip": ["11", 1] }
    },
    "8": {
        "class_type": "VAEDecode",
        "inputs": { "samples": ["3", 0], "vae": ["11", 2] }
    },
    "9": {
        "class_type": "SaveImage",
        "inputs": { "images": ["8", 0], "filename_prefix": "gamecreator" }
    },
    "10": {
        "_说明": "项目专属风格 LoRA：如无 LoRA 可改为直接引用节点 4",
        "class_type": "LoraLoader",
        "inputs": {
            "lora_name": "project_style_lora.safetensors",
            "strength_model": 0.8,
            "strength_clip": 0.8,
            "model": ["4", 0],
            "clip": ["4", 1]
        }
    },
    "11": {
        "_说明": "像素风 LoRA",
        "class_type": "LoraLoader",
        "inputs": {
            "lora_name": "pixel_art_lora.safetensors",
            "strength_model": 0.8,
            "strength_clip": 0.8,
            "model": ["10", 0],
            "clip": ["10", 1]
        }
    },
    "12": {
        "_说明": "参考图输入：程序上传母版/风格参考后回填文件名",
        "class_type": "LoadImage",
        "inputs": { "image": "{{REFERENCE_IMAGE}}" }
    },
    "13": {
        "_说明": "IP-Adapter 身份保持：将参考图特征注入正向提示词条件",
        "class_type": "IPAdapterApply",
        "inputs": {
            "weight": 0.7,
            "noise": 0.0,
            "image": ["12", 0],
            "model": ["11", 0],
            "positive": ["6", 0],
            "negative": ["7", 0]
        }
    }
}
